{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/webhook/(.*)", "dest": "/api/index.js" },
    { "src": "/register-webhook", "dest": "/api/index.js" },
    { "src": "/product/sanpham/(.*)", "dest": "/api/index.js" },
    { "src": "/", "dest": "/api/index.js" }
  ]
}
